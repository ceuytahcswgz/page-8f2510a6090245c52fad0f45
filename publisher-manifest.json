d var(--line);padding-top:16px;font-size:13px;color:#7a6e64}\n\n  @media (max-width:560px){\n    .layer{padding:26px 0 22px}\n    section{padding:42px 0 8px}\n    .plan-head{padding:16px 18px 12px}\n    .plan-price{margin-left:0;width:100%}\n    .plan-price small{text-align:left}\n    .plan-body{padding:4px 18px 18px}\n    .a{margin-left:0}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"band layer layer-a\">\n      <div class=\"wrap\">\n        <span class=\"mark\">OpenConnectUs · 一页说清</span>\n        <h1>先把 <span>OpenConnectUs</span> 看清楚：套餐、步骤、问题，逐行读</h1>\n        <p class=\"hero-lead\">这一页不打算说服你，只打算把事情摆平。三档套餐的区别在流量和设备数上；使用流程按顺序做一遍即可；剩下的是我们被问得最多的问题，附答案。</p>\n      </div>\n    </div>\n\n    <div class=\"band layer layer-b\">\n      <div class=\"wrap\">\n        <div class=\"hero-grid\">\n          <div class=\"hero-cell\">\n            <b>档位数量</b>\n            <p>三档：基础版、旗舰版、团队版。</p>\n          </div>\n          <div class=\"hero-cell\">\n            <b>定价周期</b>\n            <p>页面同时给出月付与按年付两种口径。</p>\n          </div>\n          <div class=\"hero-cell\">\n            <b>关键差异</b>\n            <p>月流量额度、同时在线设备数、线路类型。</p>\n          </div>\n          <div class=\"hero-cell\">\n            <b>阅读顺序</b>\n            <p>套餐 → 使用说明 → 客户端 → 常见问题。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"band layer layer-c\">\n      <div class=\"wrap\">\n        <span class=\"mark\">页面内跳转</span>\n        <ul class=\"jump\">\n          <li><a href=\"#plans\">看套餐对照</a></li>\n          <li><a href=\"#howto\">看使用步骤</a></li>\n          <li><a href=\"#clients\">看客户端说明</a></li>\n          <li><a href=\"#faq\">看常见问题</a></li>\n        </ul>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">01</span>套餐：三行看完，逐行展开</h2>\n      <p class=\"sub\">从上到下按投入从轻到重排列。每一行先给价格口径，再给权益条目；如果只看一条，看「每月流量」和「同时在线设备数」这两项即可。</p>\n\n      <ul class=\"plans\">\n        <li class=\"plan\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">基础版</h3>\n            <div class=\"plan-price\">¥15/月<small>按年付 ¥150/年</small></div>\n          </div>\n          <div class=\"plan-body\">\n            <ul>\n              <li>每月 100GB 流量额度</li>\n              <li>最多 3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <p class=\"plan-note\">适合单人、以网页与文档为主要用途的情况。</p>\n          </div>\n        </li>\n\n        <li class=\"plan featured\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <span class=\"tag\">常用档位</span>\n            <div class=\"plan-price\">¥35/月<small>按年付 ¥350/年</small></div>\n          </div>\n          <div class=\"plan-body\">\n            <ul>\n              <li>每月 300GB 流量额度</li>\n              <li>最多 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n            <p class=\"plan-note\">比基础版多出的部分主要在流量、设备数与线路类型上。</p>\n          </div>\n        </li>\n\n        <li class=\"plan\">\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">团队版</h3>\n            <div class=\"plan-price\">¥85/月<small>按年付 ¥850/年</small></div>\n          </div>\n          <div class=\"plan-body\">\n            <ul>\n              <li>每月 1000GB 流量额度</li>\n              <li>最多 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n            <p class=\"plan-note\">面向多人共用或需要统一路由配置的场景。</p>\n          </div>\n        </li>\n      </ul>\n\n      <div class=\"ticket\">\n        <p>价格与权益以上表为准。若后续有调整，以你下单时页面上显示的条目为最终依据；本页不承诺长期价格不变。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">02</span>使用说明：按顺序做四件事</h2>\n      <p class=\"sub\">不跳步是最省时间的做法。下面四步按依赖关系排列，前一步没完成时，后一步通常也做不下去。</p>\n\n      <ol class=\"steps\">\n        <li>\n          <strong>先定档位</strong>\n          <p>统计两件事：一个月大约用多少流量、同时要连几台设备。用这两项去对上面的套餐表，不要先看价格再看权益。</p>\n        </li>\n        <li>\n          <strong>按所选档位确认额度</strong>\n          <p>流量按自然月计，设备数按「同时在线」计。手机与电脑各算一台，不要按「人」计算。</p>\n        </li>\n        <li>\n          <strong>在设备上完成接入配置</strong>\n          <p>使用账户提供的接入信息，在你自己的设备上完成配置。配置完成后先做一次基本的连通性检查，再开始正式使用。</p>\n        </li>\n        <li>\n          <strong>记录并维护</strong>\n          <p>把账户信息、所选档位、到期时间记在一个你能找到的地方。团队版涉及多人使用时，先确定谁负责统一配置，避免重复变更。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">03</span>客户端：按你自己的平台选</h2>\n      <p class=\"sub\">客户端以你自己设备上已有的系统能力为准。这里说明各平台需要注意的点，不提供未经核实的下载地址。</p>\n\n      <div class=\"clients\">\n        <div class=\"client ticket\">\n          <h3>桌面端（Windows / macOS）</h3>\n          <p>适合长时间在线与多窗口办公。配置完成后建议做一次重启验证，确认设置在重启后仍然保留。</p>\n          <p class=\"meta\">获取方式：以账户页提供的说明为准</p>\n        </div>\n        <div class=\"client ticket\">\n          <h3>移动端（iOS / Android）</h3>\n          <p>适合外出场景。注意移动网络下流量消耗明显快于 Wi-Fi，基础版的 100GB 在手机上要按实际使用节奏估算。</p>\n          <p class=\"meta\">获取方式：以账户页提供的说明为准</p>\n        </div>\n        <div class=\"client ticket\">\n          <h3>路由器 / 团队统一配置</h3>\n          <p>团队版支持企业定制路由。多人共用时先在路由器层面统一，比逐台设备配置更省事。</p>\n          <p class=\"meta\">获取方式：随团队版服务一并说明</p>\n        </div>\n      </div>\n\n      <div class=\"ticket\">\n        <p>本页不提供任何下载链接。客户端的具体安装包与安装步骤，请以你账户内的说明为准；本页不会给出未经确认的地址。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <h2><span class=\"num\">04</span>常见问题：逐条编号，逐条回答</h2>\n      <p class=\"sub\">下列问题按被提问的频率排列。回答只涉及本页已写明的信息，未写明的部分我们不作推断。</p>\n\n      <ol class=\"faq\">\n        <li>\n          <h3 class=\"q\">三档套餐最核心的区别是什么？</h3>\n          <p class=\"a\">三件事：每月流量额度、同时在线设备数、线路类型。基础版 100GB / 3 台 / 普通线路；旗舰版 300GB / 5 台 / 含 IPLC 专线与全节点原生流媒体解锁；团队版 1000GB / 20 台 / VIP 专属高带宽节点并支持企业定制路由。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">月付和按年付怎么选？</h3>\n          <p class=\"a\">只按你预计的持续使用时长选。三档的按年付价格分别为 ¥150、¥350、¥850，与月付之间的差额你可以自己算一遍再做决定。不确定会持续多久时，先用月付。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">「同时在线设备数」怎么算？</h3>\n          <p class=\"a\">按同一时刻在线的设备数量算，不按账号数量算。手机、电脑、平板各计一台。团队版的 20 台同样按此口径。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">流量每月用不完会累积到下个月吗？</h3>\n          <p class=\"a\">本页未承诺流量结转。请按自然月内的实际额度规划使用，不要把上月的余量计入本月。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">旗舰版的 IPLC 专线适合谁？</h3>\n          <p class=\"a\">适合对线路类型有明确要求的使用者，例如需要更稳定线路特征的游戏场景。如果你的用途主要是网页与文档，基础版的普通线路节点池通常已经够用。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">团队版的「企业定制路由」需要准备什么？</h3>\n          <p class=\"a\">先确定内部由谁负责统一配置、有哪些设备需要纳入，再与专属客户经理对接。本页不对定制范围作额外承诺，具体以对接时的说明为准。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">支持哪些客户端和平台？</h3>\n          <p class=\"a\">页面内按桌面端、移动端、路由器与团队统一配置三类分别说明了注意事项。本页不提供下载地址，安装包与安装步骤请以账户内说明为准。</p>\n        </li>\n        <li>\n          <h3 class=\"q\">使用中遇到问题找谁？</h3>\n          <p class=\"a\">旗舰版含 7×24 优先工单支持，团队版含专属客户经理服务。基础版请按账户内提供的支持渠道提交问题。</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <b>OpenConnectUs</b>\n        <p>把套餐、步骤与问题放在同一页，逐行写清楚。</p>\n      </div>\n      <div>\n        <b>页面内容</b>\n        <p><a href=\"#plans\">套餐对照</a> · <a href=\"#howto\">使用步骤</a> · <a href=\"#clients\">客户端说明</a> · <a href=\"#faq\">常见问题</a></p>\n      </div>\n      <div>\n        <b>价格口径</b>\n        <p>月付与按年付并列展示；如后续调整，以下单时页面显示为准。</p>\n      </div>\n    </div>\n    <div class=\"legal\">\n      <p>本页不提供下载链接，也不对未被写明的性能、节点数量、兼容范围或退款政策作出承诺。所有权益条目均以上方套餐表列出的内容为限。</p>\n    </div>\n  </div>\n</footer>",
